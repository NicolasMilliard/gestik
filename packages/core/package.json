{
  "name": "@gestik/core",
  "version": "0.1.0",
  "description": "Framework-independent animation CSS, SVG geometry, and layout for Gestik gesture hints.",
  "homepage": "https://nicolasmilliard.github.io/gestik/",
  "bugs": {
    "url": "https://github.com/NicolasMilliard/gestik/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasMilliard/gestik.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles/drag-hint.css": "./dist/styles/drag-hint.css",
    "./styles/hold-hint.css": "./dist/styles/hold-hint.css",
    "./styles/resize-hint.css": "./dist/styles/resize-hint.css",
    "./styles/scroll-hint.css": "./dist/styles/scroll-hint.css",
    "./styles/shortcut-hint.css": "./dist/styles/shortcut-hint.css",
    "./styles/swipe-hint.css": "./dist/styles/swipe-hint.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
