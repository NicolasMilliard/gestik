{
  "name": "gestik",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --filter @gestik/docs dev",
    "build": "bun --filter @gestik/core build && bun --filter @gestik/react build",
    "build:docs": "bun --filter @gestik/docs build",
    "test": "bun --filter '*' test",
    "typecheck": "tsc --noEmit && bun --filter '*' typecheck",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "ultracite check --deny-warnings",
    "fix": "ultracite fix",
    "verify": "bun run check && bun run build && bun run typecheck && bun run test && bun run build:docs"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "8.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.13"
}
